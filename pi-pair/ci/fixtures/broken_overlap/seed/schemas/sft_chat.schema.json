{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/pi-flywheel/sft_chat.schema.json",
  "title": "PiFlywheelSftChatRow",
  "type": "object",
  "required": ["messages"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string" },
    "messages": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": { "type": "string", "enum": ["system", "user", "assistant"] },
          "content": { "type": "string" }
        }
      }
    },
    "tags": { "type": "array", "items": { "type": "string" } },
    "source": { "type": "string" }
  }
}
