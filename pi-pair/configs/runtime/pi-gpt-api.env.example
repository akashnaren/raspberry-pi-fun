# Installed on pi4 by install.sh as ~/.config/pi-pair/pi-gpt-api.env
# That installed file is mode 600. This example stays empty and is not a secret.
# Do not commit a filled copy. The user unit loads the file with EnvironmentFile=.
# A drop-in that uses an Environment= line for this key must itself be mode 600.
PI_GPT_API_KEY=
