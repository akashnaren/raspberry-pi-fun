[Unit]
Description=llama-server on pi4 cores 1-3
After=network-online.target

[Service]
Type=simple
# Decoder threads. The chat router unit keeps CPUAffinity=0.
CPUAffinity=1 2 3
ExecStart=/usr/bin/taskset -c 1-3 llama-server --flash-attn on -b 128 -ub 128 -t 3 --cache-ram 512 --kv-unified --mlock --spec-type ngram-simple --draft-max 8
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
