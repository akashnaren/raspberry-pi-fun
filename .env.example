# OpenRouter. Leave empty for dry-run (first boot on a Pi needs no key).
# On the Pi, prefer ~/.secrets/fishbowl/openrouter.env via systemd EnvironmentFile.
# Never put this file (or the key) inside workspace/.
OPENROUTER_API_KEY=

# Hard daily API ceiling in USD. Orchestrator pauses the world when hit.
DAILY_CEILING_USD=5

# HTTP + websocket
PORT=8787
HOST=127.0.0.1

# Tick interval. Spec default is 90–120s. Tighten only for local testing.
STUDIO_TICK_MIN_MS=90000
STUDIO_TICK_MAX_MS=120000

# Optional OpenRouter attribution headers
OPENROUTER_HTTP_REFERER=http://127.0.0.1:8787
OPENROUTER_TITLE=Meridian Desk
