# OpenRouter. Leave empty for dry-run (first boot on a Pi needs no key).
# systemd EnvironmentFile=-path is optional: missing file still starts.
# On the Pi, prefer ~/.secrets/fishbowl/openrouter.env (same KEY=value format).
# Never put this file (or the key) inside workspace/.
OPENROUTER_API_KEY=

# Default is dry-run. Set false AND provide a key to spend.
DRY_RUN=true

# Replay the event log for visitors. Zero API calls.
# STUDIO_MODE=replay

# Hard daily API ceiling in USD. Orchestrator pauses the world when hit.
DAILY_CEILING_USD=5

# Template say()/journal when the ceiling hits (no API).
STUDIO_LOCAL_STUBS=true

# Pi 3: skip CSS animations / soundtrack work.
# STUDIO_LITE=1

# HTTP + websocket. Default bind is every interface so a later tunnel can reach
# this one office. The kiosk still opens http://127.0.0.1:8787.
# Set HOST=127.0.0.1 to listen on loopback only.
PORT=8787
HOST=0.0.0.0

# Pi mesh. Leave MESH_URL empty to keep today's dry-run / OpenRouter path.
# Pi-PAIR router (port 18080) or direct Ollama (port 11434).
# MESH_TARGET defaults to auto and spreads across pi2, pi3, and pi4.
# Pin pi2, pi3, or pi4 only for an experiment. A pinned peer that is down errors;
# Meridian does not fall back to OpenRouter.
# MESH_URL=http://10.0.0.180:18080
# MESH_TARGET=auto
# Optional. Port 18080 selects pair; port 11434 selects ollama.
# MESH_KIND=pair
# MESH_MODEL=qwen2.5:0.5b

# Tick interval. Spec default is 90–120s. Tighten only for local testing.
STUDIO_TICK_MIN_MS=90000
STUDIO_TICK_MAX_MS=120000

# Optional OpenRouter attribution headers
OPENROUTER_HTTP_REFERER=http://127.0.0.1:8787
OPENROUTER_TITLE=Meridian Office
